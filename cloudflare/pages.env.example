# Cloudflare Pages — Dashboard → Workers & Pages → your project → Settings
#
# Builds & deployments:
#   Framework preset:     None
#   Build command:        pnpm install && pnpm run build:web:pages
#   Build output directory: apps/desktop/out/web
#   Root directory:       (leave empty — monorepo root)
#   Production branch:    web-mobile-pwa
#
# Environment variables (Settings → Environment variables → Build)
# Set separately for Production and Preview if preview URLs differ.

NODE_OPTIONS=--max-old-space-size=8192
NODE_VERSION=22
VITE_API_URL=https://folo-api.1094712.xyz
VITE_WEB_URL=https://folo.1094712.xyz
VITE_BUILD_TYPE=production

# Optional (match official deploy workflow):
# VITE_FIREBASE_CONFIG=
# VITE_SENTRY_DSN=
